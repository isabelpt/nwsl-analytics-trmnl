<!--
  NWSL Analytics — Full layout
-->
{%- capture nwsl_icon_svg %}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24"><circle cx="12" cy="12" r="10" fill="none" stroke="#000000" stroke-width="1.6"/><polygon points="12,6.5 15.5,9 14.2,13.2 9.8,13.2 8.5,9" fill="#000000"/><line x1="12" y1="2" x2="12" y2="6.5" stroke="#000000" stroke-width="1.2"/><line x1="15.5" y1="9" x2="20.5" y2="7.3" stroke="#000000" stroke-width="1.2"/><line x1="14.2" y1="13.2" x2="16.8" y2="18.5" stroke="#000000" stroke-width="1.2"/><line x1="9.8" y1="13.2" x2="7.2" y2="18.5" stroke="#000000" stroke-width="1.2"/><line x1="8.5" y1="9" x2="3.5" y2="7.3" stroke="#000000" stroke-width="1.2"/></svg>
{%- endcapture %}
 
{%- assign empty_array = "" | split: "," %}
 
<div class="title_bar">
  <img class="image image--adaptive" src="data:image/svg+xml;base64,{{ nwsl_icon_svg | base64_encode }}">
  <span class="title">NWSL Analytics</span>
  <span class="instance">{% if season %}{{ season }} Season{% else %}Standings{% endif %}</span>
</div>
 
<div class="layout layout--col gap--small lg:gap--medium mt--medium lg:mt--large p--medium lg:p--large">
  <div class="flex flex--row portrait:flex--col gap--medium w--full">
    <div class="grow lg:portrait:w--full">
      {% if standings.size > 0 %}
      <table class="table table--xsmall lg:table--small w--full">
        <thead>
          <tr>
            <th><span class="label label--small lg:label--base">#</span></th>
            <th><span class="label label--small lg:label--base">Club</span></th>
            <th class="portrait:hidden"><span class="label label--small lg:label--base">W</span></th>
            <th class="portrait:hidden"><span class="label label--small lg:label--base">D</span></th>
            <th class="portrait:hidden"><span class="label label--small lg:label--base">L</span></th>
            <th><span class="label label--small lg:label--base">GD</span></th>
            <th><span class="label label--small lg:label--base">PTS</span></th>
            <th><span class="label label--small lg:label--base">Form</span></th>
          </tr>
        </thead>
        <tbody>
          {% for t in standings %}
          {% assign playoff_line = '' %}
          {% if t.rank == 8 %}{% assign playoff_line = ' border--h-black' %}{% endif %}
          <tr>
            <td class="{{ playoff_line }}">
              <span class="label label--small lg:label--base{% if t.rank > 8 %} text--gray-40 1bit:text--black 2bit:text--gray-30{% endif %}">
                <span class="flex flex--row gap--xsmall">
                  {% if t.rank == 1 %}<span class="w--[4px] h--[4px] lg:w--[6px] lg:h--[6px] bg--black rounded--small"></span>{% endif %}
                  <span>{{ t.rank }}</span>
                </span>
              </span>
            </td>
            <td class="{{ playoff_line }}"><span class="label label--small lg:label--base{% if t.rank > 8 %} text--gray-40 1bit:text--black 2bit:text--gray-30{% endif %}">{{ t.team_name }}</span></td>
            <td class="portrait:hidden{{ playoff_line }}"><span class="label label--small lg:label--base{% if t.rank > 8 %} text--gray-40 1bit:text--black 2bit:text--gray-30{% endif %}">{{ t.w }}</span></td>
            <td class="portrait:hidden{{ playoff_line }}"><span class="label label--small lg:label--base{% if t.rank > 8 %} text--gray-40 1bit:text--black 2bit:text--gray-30{% endif %}">{{ t.d }}</span></td>
            <td class="portrait:hidden{{ playoff_line }}"><span class="label label--small lg:label--base{% if t.rank > 8 %} text--gray-40 1bit:text--black 2bit:text--gray-30{% endif %}">{{ t.l }}</span></td>
            <td class="{{ playoff_line }}"><span class="label label--small lg:label--base{% if t.rank > 8 %} text--gray-40 1bit:text--black 2bit:text--gray-30{% endif %}">{{ t.gd }}</span></td>
            <td class="{{ playoff_line }}"><span class="label label--small lg:label--base{% if t.rank > 8 %} text--gray-40 1bit:text--black 2bit:text--gray-30{% endif %}">{{ t.pts }}</span></td>
            <td class="{{ playoff_line }}">
              <span class="flex flex--row">
                {% for r in t.form | default: empty_array %}
                  <span class="label label--small lg:label--base">{{ r | upcase }}</span>
                {% endfor %}
              </span>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">Standings unavailable</span>
      {% endif %}
    </div>
 
    <div class="basis--[260px] portrait:basis--auto portrait:mt--medium shrink-0">
      {% assign sidebar_has_content = false %}
      {% if recent_results.size > 0 %}{% assign sidebar_has_content = true %}{% endif %}
      {% if xg_watch %}{% assign sidebar_has_content = true %}{% endif %}
      {% if goals_added_leaders.size > 0 %}{% assign sidebar_has_content = true %}{% endif %}
      {% if sidebar_has_content == false %}
      <div class="flex flex--col gap--medium">
        <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">No additional data available</span>
      </div>
      {% else %}
      <span class="title title--small lg:title--base">Recent Results</span>
      {% if recent_results.size > 0 %}
      {% for m in recent_results %}
      <div class="flex flex--row flex--between">
        <div>
          <span class="label label--small lg:label--base">{{ m.home }} {{ m.home_score }}–{{ m.away_score }} {{ m.away }}</span>
          <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">{{ m.date }}</span>
        </div>
      </div>
      {% endfor %}
      {% else %}
      <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">No recent results</span>
      {% endif %}
 
      <span class="title title--small lg:title--base">xG Watch</span>
      {% if xg_watch %}
        {% if xg_watch.over %}
        <div class="flex flex--row flex--between">
          <div>
            <span class="label label--small lg:label--base">{{ xg_watch.over.team_name }}</span>
            <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">GD {{ xg_watch.over.gd }} vs xGD {{ xg_watch.over.xgd }}</span>
          </div>
          <span class="title title--small lg:title--base">+{{ xg_watch.over.delta }}</span>
        </div>
        {% endif %}
        {% if xg_watch.under %}
        <div class="flex flex--row flex--between">
          <div>
            <span class="label label--small lg:label--base">{{ xg_watch.under.team_name }}</span>
            <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">GD {{ xg_watch.under.gd }} vs xGD {{ xg_watch.under.xgd }}</span>
          </div>
          <span class="title title--small lg:title--base">{{ xg_watch.under.delta }}</span>
        </div>
        {% endif %}
      {% else %}
      <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">No xG data</span>
      {% endif %}
 
      <span class="title title--small lg:title--base">Goals Added Leaders</span>
      {% if goals_added_leaders.size > 0 %}
      {% for p in goals_added_leaders %}
      <div class="flex flex--row flex--between">
        <div>
          <span class="label label--small lg:label--base">{{ p.player_name }}</span>
          <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">{{ p.team_name }}</span>
        </div>
        <span class="title title--small lg:title--base">{{ p.goals_added }}</span>
      </div>
      {% endfor %}
      {% else %}
      <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">No leader data</span>
      {% endif %}
      {% endif %}
    </div>
  </div>
 
  <div class="divider"></div>
 
  <div class="flex flex--row portrait:flex--col gap--small">
    <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">Form — W/D/L, most recent last</span>
    <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">GD — Goal Difference</span>
    <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">xGD — Expected Goal Difference</span>
    <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">Line + faded rows — playoff cutoff (top 8)</span>
  </div>
 
  <span class="label label--small lg:label--base text--gray-40 1bit:text--black 2bit:text--gray-30">Standings updated {{ updated_at | date: "%-I:%M %p" }}</span>
</div>