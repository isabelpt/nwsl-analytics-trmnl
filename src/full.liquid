<!--
NWSL Analytics 
Expects the polling response shaped by worker.js:
{
standings: [{rank, team_name, w, d, l, pts, gd, form: ['w'|'d'|'l', ...]}],
recent_results: [{home, away, home_score, away_score, date}],
xg_watch: { over: {team_name, gd, xgd, delta}, under: {...} },
goals_added_leaders: [{player_name, team_name, goals_added}]
}
-->
<style>
  .nwsl-wrap { font-family: 'JetBrains Mono', ui-monospace, monospace; color: #23221D; padding: 28px; }
  .nwsl-row { display: flex; }
  .nwsl-title { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .nwsl-sub { font-size: 6.5px; font-weight: 500; letter-spacing: 0.08em; color: #6B6960; text-transform: uppercase; margin: 14px 0 8px; }
  .nwsl-sub:first-child { margin-top: 0; }

  .nwsl-table { width: 100%; border-collapse: collapse; font-size: 8px; }
  .nwsl-table th { font-size: 6px; color: #6B6960; text-align: right; font-weight: 500; letter-spacing: 0.05em; border-bottom: 1px solid #C7C5B7; padding-bottom: 5px; }
  .nwsl-table th:first-child, .nwsl-table th:nth-child(2) { text-align: left; }
  .nwsl-table th.form-h { text-align: center; }
  .nwsl-table td { text-align: right; padding: 4.5px 0; border-bottom: 1px solid #C7C5B7; font-variant-numeric: tabular-nums; }
  .nwsl-table td:first-child, .nwsl-table td:nth-child(2) { text-align: left; }
  .nwsl-table td.team { font-weight: 700; }
  .nwsl-table td.pts { font-weight: 700; }
  .nwsl-table tr.cutline td { border-bottom: 1.4px solid #23221D; }
  .nwsl-table tr.below td { color: #B9B6A6; }
  .nwsl-lead { display: inline-block; width: 4px; height: 4px; border-radius: 1px; background: #23221D; margin-right: 4px; }

  .nwsl-form { display: flex; gap: 2px; justify-content: center; }
  .nwsl-fm { width: 6px; height: 6px; border-radius: 1px; flex-shrink: 0; }
  .nwsl-fm.w { background: #23221D; }
  .nwsl-fm.d { background: #B9B6A6; }
  .nwsl-fm.l { background: #EFEEE6; border: 1px solid #B9B6A6; }

  .nwsl-side { border-left: 1px solid #C7C5B7; padding-left: 22px; }
  .nwsl-match { padding: 6px 0; border-top: 1px solid #C7C5B7; }
  .nwsl-match:first-child { border-top: none; }
  .nwsl-match-teams { font-size: 8.5px; font-weight: 700; }
  .nwsl-match-meta { font-size: 6.5px; color: #6B6960; margin-top: 1px; }
  .nwsl-score { font-weight: 700; color: #23221D; }

  .nwsl-xg-row { display: flex; justify-content: space-between; align-items: baseline; padding: 4px 0; }
  .nwsl-xg-team { font-size: 8.5px; font-weight: 700; }
  .nwsl-xg-tag { font-size: 6px; color: #6B6960; }
  .nwsl-xg-val { font-size: 8.5px; font-weight: 700; font-variant-numeric: tabular-nums; }

  .nwsl-gp-row { display: flex; justify-content: space-between; align-items: baseline; padding: 4px 0; }
  .nwsl-gp-name { font-size: 8.5px; }
  .nwsl-gp-team { font-size: 6px; color: #6B6960; }
  .nwsl-gp-val { font-size: 8.5px; font-weight: 700; font-variant-numeric: tabular-nums; }

  .nwsl-status { font-size: 6.5px; color: #6B6960; margin-top: 14px; }

  .nwsl-legend { display: flex; gap: 18px; padding-top: 14px; margin-top: 16px; border-top: 1px solid #C7C5B7; }
  .nwsl-legend-item { display: flex; align-items: center; gap: 5px; font-size: 6px; color: #6B6960; letter-spacing: 0.02em; }
  .nwsl-legend-marks { display: flex; gap: 2px; }
</style>

<div class="nwsl-wrap">
  <div class="nwsl-row" style="gap: 26px;">
    <div style="flex: 1;">
      <p class="nwsl-title">NWSL Standings</p>
      <table class="nwsl-table">
        <thead>
          <tr><th>#</th><th>Club</th><th>W</th><th>D</th><th>L</th><th>GD</th><th>PTS</th><th class="form-h">Form</th></tr>
        </thead>
        <tbody>
          {% for t in standings %}
          <tr class="{% if t.rank == 8 %}cutline{% endif %}{% if t.rank > 8 %} below{% endif %}">
            <td>{% if t.rank == 1 %}<span class="nwsl-lead"></span>{% endif %}{{ t.rank }}</td>
            <td class="team">{{ t.team_name }}</td>
            <td>{{ t.w }}</td>
            <td>{{ t.d }}</td>
            <td>{{ t.l }}</td>
            <td>{{ t.gd }}</td>
            <td class="pts">{{ t.pts }}</td>
            <td>
              <div class="nwsl-form">
                {% for r in t.form %}<span class="nwsl-fm {{ r }}"></span>{% endfor %}
              </div>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="nwsl-side" style="flex: 0 0 240px;">
      <p class="nwsl-sub">Recent Results</p>
      {% for m in recent_results %}
      <div class="nwsl-match">
        <div class="nwsl-match-teams">{{ m.home }} <span class="nwsl-score">{{ m.home_score }}–{{ m.away_score }}</span> {{ m.away }}</div>
        <div class="nwsl-match-meta">{{ m.date | date: "%b %-d" }}</div>
      </div>
      {% endfor %}

      <p class="nwsl-sub">xG Watch</p>
      {% if xg_watch.over %}
      <div class="nwsl-xg-row">
        <div>
          <div class="nwsl-xg-team">{{ xg_watch.over.team_name }}</div>
          <div class="nwsl-xg-tag">GD {{ xg_watch.over.gd }} vs xGD {{ xg_watch.over.xgd }}</div>
        </div>
        <div class="nwsl-xg-val">+{{ xg_watch.over.delta }}</div>
      </div>
      {% endif %}
      {% if xg_watch.under %}
      <div class="nwsl-xg-row">
        <div>
          <div class="nwsl-xg-team">{{ xg_watch.under.team_name }}</div>
          <div class="nwsl-xg-tag">GD {{ xg_watch.under.gd }} vs xGD {{ xg_watch.under.xgd }}</div>
        </div>
        <div class="nwsl-xg-val">{{ xg_watch.under.delta }}</div>
      </div>
      {% endif %}

      <p class="nwsl-sub">Goals Added Leaders</p>
      {% for p in goals_added_leaders %}
      <div class="nwsl-gp-row">
        <div>
          <div class="nwsl-gp-name">{{ p.player_name }}</div>
          <div class="nwsl-gp-team">{{ p.team_name }}</div>
        </div>
        <div class="nwsl-gp-val">{{ p.goals_added }}</div>
      </div>
      {% endfor %}
    </div>
  </div>

  <div class="nwsl-legend">
    <div class="nwsl-legend-item">
      <span class="nwsl-legend-marks"><span class="nwsl-fm w"></span></span> Win
    </div>
    <div class="nwsl-legend-item">
      <span class="nwsl-legend-marks"><span class="nwsl-fm d"></span></span> Draw
    </div>
    <div class="nwsl-legend-item">
      <span class="nwsl-legend-marks"><span class="nwsl-fm l"></span></span> Loss
    </div>
    <div class="nwsl-legend-item">GD - Goal Difference</div>
    <div class="nwsl-legend-item">xGD - Expected Goal Difference</div>
    <div class="nwsl-legend-item">Solid line - playoff cutoff (top 8)</div>
  </div>

  <p class="nwsl-status">Standings updated {{ updated_at | date: "%-I:%M %p" }}</p>
</div>