<!--
  NWSL Analytics — Full layout, rewritten on TRMNL Framework v3.3 classes
  (title_bar / layout / columns / table / title / label / description / value /
  flex / divider / bg--*, text--* grayscale tokens) instead of custom CSS.

  Expects the polling response shaped by worker.js:
  {
    standings: [{rank, team_name, w, d, l, pts, gd, form: ['w'|'d'|'l', ...]}],
    recent_results: [{home, away, home_score, away_score, date}],
    xg_watch: { over: {team_name, gd, xgd, delta}, under: {...} },
    goals_added_leaders: [{player_name, team_name, goals_added}]
  }
-->

<div class="layout layout--col gap--medium">
  <div class="columns">
    <div class="column">
      <span class="title title--small">NWSL Standings</span>
      <table class="table" data-table-limit="true">
        <thead>
          <tr>
            <th><span class="title title--small">#</span></th>
            <th><span class="title title--small">Club</span></th>
            <th><span class="title title--small">W</span></th>
            <th><span class="title title--small">D</span></th>
            <th><span class="title title--small">L</span></th>
            <th><span class="title title--small">GD</span></th>
            <th><span class="title title--small">PTS</span></th>
            <th><span class="title title--small">Form</span></th>
          </tr>
        </thead>
        <tbody>
          {% for t in standings %}
          <tr>
            <td>
              <span class="label label--small{% if t.rank > 8 %} text--gray-40{% endif %}">
                <span class="flex flex--row gap--xsmall">
                  {% if t.rank == 1 %}<span class="w--[4px] h--[4px] bg--black rounded--[1px]"></span>{% endif %}
                  <span>{{ t.rank }}</span>
                </span>
              </span>
            </td>
            <td><span class="label{% if t.rank > 8 %} text--gray-40{% endif %}">{{ t.team_name }}</span></td>
            <td><span class="label label--small{% if t.rank > 8 %} text--gray-40{% endif %}">{{ t.w }}</span></td>
            <td><span class="label label--small{% if t.rank > 8 %} text--gray-40{% endif %}">{{ t.d }}</span></td>
            <td><span class="label label--small{% if t.rank > 8 %} text--gray-40{% endif %}">{{ t.l }}</span></td>
            <td><span class="label label--small{% if t.rank > 8 %} text--gray-40{% endif %}">{{ t.gd }}</span></td>
            <td><span class="label label--small{% if t.rank > 8 %} text--gray-40{% endif %}">{{ t.pts }}</span></td>
            <td>
              <span class="flex flex--row gap--xsmall">
                {% for r in t.form %}
                  {% if r == 'w' %}<span class="w--[6px] h--[6px] bg--black rounded--[1px]"></span>
                  {% elsif r == 'd' %}<span class="w--[6px] h--[6px] bg--gray-45 rounded--[1px]"></span>
                  {% else %}<span class="w--[6px] h--[6px] bg--gray-15 rounded--[1px]"></span>
                  {% endif %}
                {% endfor %}
              </span>
            </td>
          </tr>
          {% if t.rank == 8 %}
          <tr><td colspan="8"><div class="divider"></div></td></tr>
          {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="column">
      <span class="title title--small">Recent Results</span>
      {% for m in recent_results %}
      <div class="flex flex--row flex--between">
        <div>
          <span class="description">{{ m.home }} {{ m.home_score }}–{{ m.away_score }} {{ m.away }}</span>
          <span class="label label--small text--gray-40">{{ m.date | date: "%b %-d" }}</span>
        </div>
      </div>
      {% endfor %}

      <span class="title title--small">xG Watch</span>
      {% if xg_watch.over %}
      <div class="flex flex--row flex--between">
        <div>
          <span class="description">{{ xg_watch.over.team_name }}</span>
          <span class="label label--small text--gray-40">GD {{ xg_watch.over.gd }} vs xGD {{ xg_watch.over.xgd }}</span>
        </div>
        <span class="value value--xsmall">+{{ xg_watch.over.delta }}</span>
      </div>
      {% endif %}
      {% if xg_watch.under %}
      <div class="flex flex--row flex--between">
        <div>
          <span class="description">{{ xg_watch.under.team_name }}</span>
          <span class="label label--small text--gray-40">GD {{ xg_watch.under.gd }} vs xGD {{ xg_watch.under.xgd }}</span>
        </div>
        <span class="value value--xsmall">{{ xg_watch.under.delta }}</span>
      </div>
      {% endif %}

      <span class="title title--small">Goals Added Leaders</span>
      {% for p in goals_added_leaders %}
      <div class="flex flex--row flex--between">
        <div>
          <span class="description">{{ p.player_name }}</span>
          <span class="label label--small text--gray-40">{{ p.team_name }}</span>
        </div>
        <span class="value value--xsmall">{{ p.goals_added }}</span>
      </div>
      {% endfor %}
    </div>
  </div>

  <div class="divider"></div>

  <div class="flex flex--row gap--medium">
    <div class="flex flex--row gap--xsmall">
      <span class="w--[6px] h--[6px] bg--black rounded--[1px]"></span>
      <span class="label label--small text--gray-40">Win</span>
    </div>
    <div class="flex flex--row gap--xsmall">
      <span class="w--[6px] h--[6px] bg--gray-45 rounded--[1px]"></span>
      <span class="label label--small text--gray-40">Draw</span>
    </div>
    <div class="flex flex--row gap--xsmall">
      <span class="w--[6px] h--[6px] bg--gray-15 rounded--[1px]"></span>
      <span class="label label--small text--gray-40">Loss</span>
    </div>
    <span class="label label--small text--gray-40">GD — Goal Difference</span>
    <span class="label label--small text--gray-40">xGD — Expected Goal Difference</span>
    <span class="label label--small text--gray-40">Divider row — playoff cutoff (top 8)</span>
  </div>

  <span class="label label--small text--gray-40">Standings updated {{ updated_at | date: "%-I:%M %p" }}</span>
</div>