<!--
  NWSL Analytics — Half Horizontal layout (800×240), TRMNL Framework v3.3.
  Same polling payload as the full-size markup. Paste into the "Half
  Horizontal" markup tab. Uses the same title_bar icon pattern, table--xsmall
  density, and label--small/title--small text sizing as the full layout.
-->
{%- capture nwsl_icon_svg %}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24"><circle cx="12" cy="12" r="10" fill="none" stroke="#000000" stroke-width="1.6"/><polygon points="12,6.5 15.5,9 14.2,13.2 9.8,13.2 8.5,9" fill="#000000"/><line x1="12" y1="2" x2="12" y2="6.5" stroke="#000000" stroke-width="1.2"/><line x1="15.5" y1="9" x2="20.5" y2="7.3" stroke="#000000" stroke-width="1.2"/><line x1="14.2" y1="13.2" x2="16.8" y2="18.5" stroke="#000000" stroke-width="1.2"/><line x1="9.8" y1="13.2" x2="7.2" y2="18.5" stroke="#000000" stroke-width="1.2"/><line x1="8.5" y1="9" x2="3.5" y2="7.3" stroke="#000000" stroke-width="1.2"/></svg>
{%- endcapture %}

<div class="title_bar">
  <img class="image image--adaptive" src="data:image/svg+xml;base64,{{ nwsl_icon_svg | base64_encode }}">
  <span class="title">NWSL Analytics</span>
</div>

<div class="layout layout--col gap--small mt--medium">
  <div class="flex flex--row gap--medium">
    <div class="grow">
      <table class="table table--xsmall">
        <thead>
          <tr>
            <th><span class="title title--small">#</span></th>
            <th><span class="title title--small">Club</span></th>
            <th><span class="title title--small">W</span></th>
            <th><span class="title title--small">D</span></th>
            <th><span class="title title--small">L</span></th>
            <th><span class="title title--small">GD</span></th>
            <th><span class="title title--small">PTS</span></th>
            <th><span class="title title--small">Form</span></th>
          </tr>
        </thead>
        <tbody>
          {% for t in standings limit: 7 %}
          <tr>
            <td>
              <span class="label label--small">
                <span class="flex flex--row gap--xsmall">
                  {% if t.rank == 1 %}<span class="w--[4px] h--[4px] bg--black rounded--[1px]"></span>{% endif %}
                  <span>{{ t.rank }}</span>
                </span>
              </span>
            </td>
            <td><span class="label label--small">{{ t.team_name }}</span></td>
            <td><span class="label label--small">{{ t.w }}</span></td>
            <td><span class="label label--small">{{ t.d }}</span></td>
            <td><span class="label label--small">{{ t.l }}</span></td>
            <td><span class="label label--small">{{ t.gd }}</span></td>
            <td><span class="label label--small">{{ t.pts }}</span></td>
            <td>
              <span class="flex flex--row gap--xsmall">
                {% for r in t.form %}
                  {% if r == 'w' %}<span class="w--[6px] h--[6px] bg--black rounded--[1px]"></span>
                  {% elsif r == 'd' %}<span class="w--[6px] h--[6px] bg--gray-45 rounded--[1px]"></span>
                  {% else %}<span class="w--[6px] h--[6px] bg--gray-15 rounded--[1px]"></span>
                  {% endif %}
                {% endfor %}
              </span>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="divider divider--v"></div>

    <div class="basis--[220px] shrink-0">
      <span class="title title--small">xG Watch</span>
      {% if xg_watch.over %}
      <div class="flex flex--row flex--between">
        <div>
          <span class="label label--small">{{ xg_watch.over.team_name }}</span>
          <span class="label label--small text--gray-40">GD {{ xg_watch.over.gd }} vs xGD {{ xg_watch.over.xgd }}</span>
        </div>
        <span class="title title--small">+{{ xg_watch.over.delta }}</span>
      </div>
      {% endif %}
      {% if xg_watch.under %}
      <div class="flex flex--row flex--between">
        <div>
          <span class="label label--small">{{ xg_watch.under.team_name }}</span>
          <span class="label label--small text--gray-40">GD {{ xg_watch.under.gd }} vs xGD {{ xg_watch.under.xgd }}</span>
        </div>
        <span class="title title--small">{{ xg_watch.under.delta }}</span>
      </div>
      {% endif %}

      <span class="title title--small">Goals Added Leader</span>
      {% for p in goals_added_leaders limit: 1 %}
      <div class="flex flex--row flex--between">
        <div>
          <span class="label label--small">{{ p.player_name }}</span>
          <span class="label label--small text--gray-40">{{ p.team_name }}</span>
        </div>
        <span class="title title--small">{{ p.goals_added }}</span>
      </div>
      {% endfor %}
    </div>
  </div>

  <span class="label label--small text--gray-40">Standings updated {{ updated_at | date: "%-I:%M %p" }}</span>
</div>