<!--
  NWSL Analytics — Half Horizontal layout (800×240), TRMNL Framework v3.3.
  Same polling payload as the full-size markup. Paste into the "Half
  Horizontal" markup tab.

  Rebuilt as two half-width standings tables (ranks 1-8 / 9-16) instead of a
  table + stats sidebar — that fits every team instead of just the top 7, and
  uses the full 800px width instead of leaving a sidebar's worth of empty
  space. W/D/L are dropped (same tradeoff as the Half Vertical layout) so two
  tables fit side by side; GD/PTS/Form carry the story.
-->
{%- capture nwsl_icon_svg %}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24"><circle cx="12" cy="12" r="10" fill="none" stroke="#000000" stroke-width="1.6"/><polygon points="12,6.5 15.5,9 14.2,13.2 9.8,13.2 8.5,9" fill="#000000"/><line x1="12" y1="2" x2="12" y2="6.5" stroke="#000000" stroke-width="1.2"/><line x1="15.5" y1="9" x2="20.5" y2="7.3" stroke="#000000" stroke-width="1.2"/><line x1="14.2" y1="13.2" x2="16.8" y2="18.5" stroke="#000000" stroke-width="1.2"/><line x1="9.8" y1="13.2" x2="7.2" y2="18.5" stroke="#000000" stroke-width="1.2"/><line x1="8.5" y1="9" x2="3.5" y2="7.3" stroke="#000000" stroke-width="1.2"/></svg>
{%- endcapture %}

<div class="title_bar">
  <img class="image image--adaptive" src="data:image/svg+xml;base64,{{ nwsl_icon_svg | base64_encode }}">
  <span class="title">NWSL Analytics</span>
</div>

<div class="layout layout--col gap--small mt--medium">
  <div class="flex flex--row gap--medium">
    <div class="grow">
      <table class="table table--xsmall w--full">
        <thead>
          <tr>
            <th class="px--xsmall"><span class="title title--xsmall">#</span></th>
            <th class="px--xsmall"><span class="title title--xsmall">Club</span></th>
            <th class="px--xsmall"><span class="title title--xsmall">GD</span></th>
            <th class="px--xsmall"><span class="title title--xsmall">PTS</span></th>
            <th class="px--xsmall"><span class="title title--xsmall">Form</span></th>
          </tr>
        </thead>
        <tbody>
          {% for t in standings limit: 8 %}
          <tr>
            <td class="px--small">
              <span class="label label--small{% if t.rank > 8 %} text--gray-40{% endif %}">
                <span class="flex flex--row gap--xsmall">
                  {% if t.rank == 1 %}<span class="w--[4px] h--[4px] bg--black rounded--[1px]"></span>{% endif %}
                  <span>{{ t.rank }}</span>
                </span>
              </span>
            </td>
            <td class="px--small"><span class="label label--small{% if t.rank > 8 %} text--gray-40{% endif %}">{{ t.team_name }}</span></td>
            <td class="px--small"><span class="label label--small{% if t.rank > 8 %} text--gray-40{% endif %}">{{ t.gd }}</span></td>
            <td class="px--small"><span class="label label--small{% if t.rank > 8 %} text--gray-40{% endif %}">{{ t.pts }}</span></td>
            <td class="px--small">
              <span class="flex flex--row gap--xsmall">
                {% for r in t.form %}
                  {% if r == 'w' %}<span class="w--[6px] h--[6px] bg--black rounded--[1px]"></span>
                  {% elsif r == 'd' %}<span class="w--[6px] h--[6px] bg--gray-45 rounded--[1px]"></span>
                  {% else %}<span class="w--[6px] h--[6px] bg--gray-15 rounded--[1px]"></span>
                  {% endif %}
                {% endfor %}
              </span>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="divider divider--v"></div>

    <div class="grow">
      <table class="table table--xsmall w--full">
        <thead>
          <tr>
            <th class="px--small"><span class="title title--small">#</span></th>
            <th class="px--small"><span class="title title--small">Club</span></th>
            <th class="px--small"><span class="title title--small">GD</span></th>
            <th class="px--small"><span class="title title--small">PTS</span></th>
            <th class="px--small"><span class="title title--small">Form</span></th>
          </tr>
        </thead>
        <tbody>
          {% for t in standings offset: 8 limit: 8 %}
          <tr>
            <td class="px--small">
              <span class="label label--small text--gray-40">
                <span class="flex flex--row gap--xsmall">
                  <span>{{ t.rank }}</span>
                </span>
              </span>
            </td>
            <td class="px--small"><span class="label label--small text--gray-40">{{ t.team_name }}</span></td>
            <td class="px--small"><span class="label label--small text--gray-40">{{ t.gd }}</span></td>
            <td class="px--small"><span class="label label--small text--gray-40">{{ t.pts }}</span></td>
            <td class="px--small">
              <span class="flex flex--row gap--xsmall">
                {% for r in t.form %}
                  {% if r == 'w' %}<span class="w--[6px] h--[6px] bg--black rounded--[1px]"></span>
                  {% elsif r == 'd' %}<span class="w--[6px] h--[6px] bg--gray-45 rounded--[1px]"></span>
                  {% else %}<span class="w--[6px] h--[6px] bg--gray-15 rounded--[1px]"></span>
                  {% endif %}
                {% endfor %}
              </span>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <span class="label label--small text--gray-40">Standings updated {{ updated_at | date: "%-I:%M %p" }} · Faded — outside the playoff cutoff (top 8)</span>
</div>